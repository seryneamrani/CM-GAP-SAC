<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cm_gap_sac_navigation</name>
  <version>0.2.0</version>
  <description>
    Cross-Modal Gated Attention Prioritized SAC with CBF safety shield
    for socially-aware mobile robot navigation. Built on top of Zhang et al. 2025 (GAP_SAC),
    extended with multi-modal perception (LiDAR + YOLO/DeepSORT pedestrian tracks),
    attention-entropy weighted PER, and a Control Barrier Function safety shield.
    Target platform: AgileX LIMO Pro under ROS 2 Jazzy + Gazebo Harmonic.
  </description>
  <maintainer email="seryne.amrani@estin.dz">Seryne Amrani</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS 2 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Gazebo bridge (Harmonic via ros_gz) -->
  <depend>ros_gz_interfaces</depend>
  <depend>ros_gz_bridge</depend>

  <!-- Pure Python deps (declared for documentation; resolved by pip/conda) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
