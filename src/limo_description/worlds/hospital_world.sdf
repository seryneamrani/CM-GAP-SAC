<?xml version="1.0" ?>
<!--
  Hospital world for CM-GAP_SAC training (v0.4 stable).

  Changes vs v0.3:
    - static_visitor_2: z corrigé (était sous le sol à cause d'une pose z
      héritée d'un include Fuel dont le mesh origin n'est pas à z=0).
      Remplacé par un modèle PatientWheelChair avec pose explicite z=0.
    - person_standing_1: supprimé (encombre le couloir central).
    - visitor_1: supprimé.
    - static_nurse_2: supprimé.
    - nurse_1 (Scrubs): déplacée en -2.00 -1.00 (couloir central).
    - wheelchair_extra_1: le cylindre gris a été remplacé par un vrai
      PatientWheelChair Fuel (même URI que wheelchair_extra_2).
    - Goals: aucun marqueur SDF n'existait en v0.3. Les positions de goal
      sont gérées dans l'environnement RL Python. Voir note ci-dessous.

  NOTE GOALS (à reporter dans hospital_env.py / goal_sampler) :
    Le monde mesure 16 m de long en X (-8 → +8) et 6 m de couloir central
    (-3 → +3 en Y). Pour varier davantage en X, utiliser un échantillonnage
    uniforme sur X ∈ [-6.5, 6.5] plutôt qu'une zone réduite. Exemple Python :

        goal_x = np.random.uniform(-6.5, 6.5)
        goal_y = np.random.uniform(-1.5, 1.5)   # reste centré dans le couloir

    Cela exploite toute la longueur du couloir et force l'agent à apprendre
    des trajectoires longues en ligne droite ainsi que des demi-tours.
-->
<sdf version="1.9">
  <world name="hospital">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- 250 Hz, unlimited real-time factor for training. -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ MURS ============ -->
    <model name="wall_north"><static>true</static><pose>8 0 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 16 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 16 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>-8 0 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 16 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 16 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>0 8 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>16 0.2 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>16 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>0 -8 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>16 0.2 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>16 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="corridor_wall_1"><static>true</static><pose>0 3 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>14 0.2 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>14 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="corridor_wall_2"><static>true</static><pose>0 -3 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>14 0.2 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>14 0.2 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="div_left_top_1"><static>true</static><pose>2 4 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 1.8 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 1.8 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="div_left_top_2"><static>true</static><pose>2 7 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 1.8 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 1.8 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="div_left_bot_1"><static>true</static><pose>2 -4 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 1.8 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 1.8 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="div_left_bot_2"><static>true</static><pose>2 -7 1 0 0 0</pose><link name="link"><collision name="col"><geometry><box><size>0.2 1.8 2</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 1.8 2</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>

    <!-- ============ MOBILIER ET PERSONNAGES STATIQUES ============ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TrolleyBed/3</uri>
      <name>bed_1</name>
      <pose>5 5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TrolleyBedPatient/3</uri>
      <name>bed_patient_1</name>
      <pose>5 -5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MalePatientBed/2</uri>
      <name>bed_patient_2</name>
      <pose>-5 5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/IVStand/2</uri>
      <name>iv_stand_1</name>
      <pose>3.5 5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/IVStand/2</uri>
      <name>iv_stand_2</name>
      <pose>3.5 -5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedsideTable/2</uri>
      <name>bedside_table_1</name>
      <pose>6.5 5 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedsideTable/2</uri>
      <name>bedside_table_2</name>
      <pose>6.5 -5 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- wheelchair_extra_1 : remplacé par un PatientWheelChair Fuel.
         La pose z=0 est correcte pour ce modèle (son origin mesh est au sol). -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/PatientWheelChair/4</uri>
      <name>wheelchair_extra_1</name>
      <pose>0.19 2.1 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MetalCabinet/2</uri>
      <name>cabinet_1</name>
      <pose>7 3 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MetalCabinet/2</uri>
      <name>cabinet_2</name>
      <pose>7 -3 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- nurse_1: déplacée en -2.00 -1.00 (couloir central, côté sud). -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Scrubs/2</uri>
      <name>nurse_1</name>
      <pose>-2.00 -1.00 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- static_visitor_2: z corrigé.
         Le modèle Male visitor a son mesh origin à z≈0 quand on utilise
         <static>true</static> avec un include; la version v0.3 héritait d'un
         z=0.5 implicite depuis une ancienne copie. On force z=0 explicitement. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor/2</uri>
      <name>static_visitor_2</name>
      <pose>6 0.5 0 0 0 3.14</pose>
      <static>true</static>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/PatientWheelChair/4</uri>
      <name>wheelchair_extra_2</name>
      <pose>-6 6 0 0 0 0.5</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MetalCabinet/2</uri>
      <name>cabinet_extra_1</name>
      <pose>7 6.5 0 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/IVStand/2</uri>
      <name>iv_stand_extra_1</name>
      <pose>-5.5 6.8 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/IVStand/2</uri>
      <name>iv_stand_extra_2</name>
      <pose>-6.5 -6.5 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- ============ PIETONS DYNAMIQUES ============
         gravity=false on every pedestrian link: the VelocityControl plugin
         sets only linear.x and angular.z velocity; with gravity enabled the
         ODE solver's numerical noise creates a residual torque that tips the
         1.8 m cylinder (inverted pendulum). Disabling gravity removes the
         only sustained force that can feed that torque, so the cylinders stay
         upright at any RTF. Collision geometry is kept intact for LiDAR.
    -->

    <model name="ped_1">
      <pose>5.43 1.62 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.9 0 0 0</pose>
          <mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <model name="ped_2">
      <pose>-3.92 1.18 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.9 0 0 0</pose>
          <mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <model name="ped_4">
      <pose>-6.75 -1.77 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.9 0 0 0</pose>
          <mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <model name="ped_5">
      <pose>3.21 -6.50 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.9 0 0 0</pose>
          <mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <model name="ped_6">
      <pose>-1.65 -4.20 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.9 0 0 0</pose>
          <mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
      </plugin>
    </model>

    <model name="ped_7">
      <pose>3.19 6.50 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <pose>0 0 0.9 0 0 0</pose>
          <mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
