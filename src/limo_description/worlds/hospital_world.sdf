    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/PatientWheelChair/4</uri><name>wheelchair_extra_1</name><pose>0.19 2.1 0 0 0 1.57</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/PatientWheelChair/4</uri><name>wheelchair_extra_2</name><pose>-6 6 0 0 0 0.5</pose></include>
