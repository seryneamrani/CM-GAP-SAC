    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor/2</uri><name>static_visitor_2</name><pose>6 0.5 1 0 0 3.14</pose></include>


    <!-- ============ PIÉTONS DYNAMIQUES (collision cylindrique + mesh humain) ============ -->

    <model name="ped_1">
      <pose>5.43 1.62 0 0 0 0</pose>
      <link name="link">
        <inertial><mass>60.0</mass>
          <inertia><ixx>16.245</ixx><iyy>16.245</iyy><izz>2.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="col">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>1.80</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 1.57</pose>
          <geometry><mesh><uri>file:///home/seryne/.gz/fuel/fuel.gazebosim.org/openrobotics/models/walking%20person/3/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
